DATABASE_URL=postgresql://postgres:password@localhost:5432/gymops
SECRET_KEY=change-this-secret-key-in-production-min-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Backblaze B2 (S3-compatible API) — private bucket for member photos/documents.
# Do not commit real values here; set these in your actual .env / Render env vars.
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=gym-management-photos
B2_KEY_ID=
B2_APPLICATION_KEY=
